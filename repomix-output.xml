    const rawSlices = [

        { id: "cogs", label: "Bahan Baku (HPP)", amount: cogs, color: "#d46738" },

        { id: "payroll", label: "Pegawai & Gaji", amount: payroll, color: "#256f4d" },

        { id: "utilities", label: "Utilitas & Tempat", amount: utilities, color: "#3a7d88" },

        { id: "operational", label: "Operasional & Lainnya", amount: operational, color: "#5f8a6c" },

        { id: "marketing", label: "Pemasaran & Iklan", amount: marketing, color: "#7e5f91" },

        { id: "depreciation", label: "Penyusutan Aset", amount: depreciation, color: "#8e998f" },

    ];

    if (netProfit > 0) {

        rawSlices.push({ id: "profit", label: "Laba Bersih", amount: netProfit, color: "#84cc16" });

    }

    const slices = rawSlices.filter((s) => s.amount > 0);

    // Rasio terhadap Omzet sebagai basis 100%

    const denominator = revenue > 0 ? revenue : slices.reduce((sum, s) => sum + s.amount, 0);

    const totalSlicesAmount = slices.reduce((sum, s) => sum + s.amount, 0);

    const pieTotal = totalSlicesAmount > 0 ? totalSlicesAmount : 1;

    const cx = 110;

