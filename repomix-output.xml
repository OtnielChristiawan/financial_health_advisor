                <div className="stat-value">{money(report.revenue, true)}</div>

                <div className="stat-foot">

                    <span className={`delta ${revGrowth !== null ? (revGrowth >= 0 ? "positive" : "negative") : "neutral"}`}>

                        {revGrowth !== null ? percent(revGrowth) : ""}

                    </span>

                    <span>{revGrowth !== null ? "vs bulan lalu" : "Omzet tercatat"}</span>

                </div>

            </article>

            {/* KPI 2: Laba Bersih */}

            <article className="stat-card">

                <div className="stat-top">

                    <span>Laba Bersih*</span>

                    <span className="stat-icon">🎯</span>

                </div>

                <div className="stat-value">{money(report.netProfit, true)}</div>

                <div className="stat-foot">

                    <span className={`delta ${report.netProfit >= 0 ? "positive" : "negative"}`}>

                        {report.netProfit >= 0 ? "Untung" : "Rugi"}

                    </span>

                    <span>{report.isClosed ? "Final setelah tutup buku" : "Estimasi berjalan"}</span>

                </div>

            </article>

            {/* KPI 3: Saldo Kas Total + Rincian Kas vs Rekening */}

            <article className="stat-card">

                <div className="stat-top">

                    <span>Total Saldo Kas</span>

                    <span className="stat-icon">💰</span>

                </div>

                <div className="stat-value">{money(report.cash + report.bank, true)}</div>

                <div className="stat-subsplit">

