    const utilities = Number(ob.utilities || 0);

    const marketing = Number(report.marketing || ob.marketing || 0);

    const operational = Number((ob.operational || 0) + (ob.maintenance || 0) + (ob.general || 0));

    const depreciation = Number(report.depreciation || 0);

