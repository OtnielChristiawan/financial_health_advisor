for nm, typ, val in [("Demo_Sep_Revenue", "Revenue", sep["rev"]), ("Demo_Sep_COGS", "COGS", sep["cogs"]),
                     ("Demo_Sep_OPEX", "FixedOPEX", sep["opex"]), ("Demo_Sep_Marketing", "MarketingOPEX", sep["mkt"]),
