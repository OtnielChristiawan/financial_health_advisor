                        {isRunwayCritical

                            ? `Batas aman min. ${minRunwayDays} hari (${minRunwayMonths} bln)`

                            : "Kas aman jika omzet drop ke nol"}

                    </span>

                </div>

            </article>

        </section>

    );

}

function ReasonerStatus({ reasoner }) {

    if (reasoner.status === "loading") return <div className="reasoner-pill">Mengirim fakta ke knowledge base OWL/Pellet…</div>;

    if (reasoner.status === "ok") {

        const visible = reasoner.result.inferred.filter((name) => ["CostEscalation", "MarginPressure", "OPEXPressure", "MarketingEfficiencyReview", "ProfitPressure", "ProfitCashGap", "LiquidityPressure", "OwnerDrawLiquidityPressure", "LiquidityCritical"].includes(name));

        return <div className="reasoner-pill"><strong>{reasoner.result.engine} aktif</strong> · {reasoner.result.java} · {visible.length ? visible.join(", ") : "tidak ada anomali"} · {reasoner.result.elapsed_ms} ms</div>;

    }

    return <div className={`reasoner-pill ${reasoner.status === "error" ? "error" : ""}`}>{reasoner.status === "error" ? `Reasoner OWL error: ${reasoner.error}` : reasoner.error || "Reasoner menunggu data pembanding."}</div>;

}

function topRoundedBar(x, y, w, h, r = 4) {

    if (h <= 0) return "";

    const actualR = Math.min(r, h, w / 2);

    return `M ${x.toFixed(1)} ${(y + h).toFixed(1)} L ${x.toFixed(1)} ${(y + actualR).toFixed(1)} Q ${x.toFixed(1)} ${y.toFixed(1)} ${(x + actualR).toFixed(1)} ${y.toFixed(1)} L ${(x + w - actualR).toFixed(1)} ${y.toFixed(1)} Q ${(x + w).toFixed(1)} ${y.toFixed(1)} ${(x + w).toFixed(1)} ${(y + actualR).toFixed(1)} L ${(x + w).toFixed(1)} ${(y + h).toFixed(1)} Z`;

}

function bottomRoundedBar(x, y, w, h, r = 4) {

    if (h <= 0) return "";

    const actualR = Math.min(r, h, w / 2);

    return `M ${x.toFixed(1)} ${y.toFixed(1)} L ${(x + w).toFixed(1)} ${y.toFixed(1)} L ${(x + w).toFixed(1)} ${(y + h - actualR).toFixed(1)} Q ${(x + w).toFixed(1)} ${(y + h).toFixed(1)} ${(x + w - actualR).toFixed(1)} ${(y + h).toFixed(1)} L ${(x + actualR).toFixed(1)} ${(y + h).toFixed(1)} Q ${x.toFixed(1)} ${(y + h).toFixed(1)} ${x.toFixed(1)} ${(y + h - actualR).toFixed(1)} Z`;

}

