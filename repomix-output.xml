# Aug (Rp juta -> rupiah penuh): rev 90, COGS 38, OPEX 30, Mkt 4, Dep 1 => NP 17
# Sep: rev 100, COGS 46.5, OPEX 32, Mkt 6.5, Dep 1 => NP 14
M = 1_000_000
aug = {"rev": 90, "cogs": 38, "opex": 30, "mkt": 4, "dep": 1}
