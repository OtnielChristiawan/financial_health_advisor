  <rdf:Description rdf:about="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#MarginPressure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Margin Pressure</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#WarningCondition"/>
    <rdfs:subClassOf rdf:nodeID="Nbd195a41f68445d48d17933b3bc1bf98"/>
    <rdfs:subClassOf rdf:nodeID="N62b426c7ad2c433b8e133323dccd87fb"/>
    <rdfs:subClassOf rdf:nodeID="Nab991305a02347628655f18cae7dcc93"/>
    <rdfs:subClassOf rdf:nodeID="N8a9adab97765422c96272b2792849d27"/>
    <rdfs:comment xml:lang="en">Gross margin fell below the business's own baseline while COGS grew faster than revenue.</rdfs:comment>
    <hasTitle>Tekanan Margin Kotor (Margin Pressure)</hasTitle>
    <hasDomain>Profitabilitas</hasDomain>
    <hasSeverity>Waspada</hasSeverity>
    <hasRuleId>F02_MarginPressure</hasRuleId>
    <hasExplanationText>Gross profit margin berada di bawah baseline historis bersamaan dengan kenaikan biaya bahan yang melebihi pendapatan.</hasExplanationText>
    <hasAdviceText>Tinjau harga jual menu, periksa apakah terjadi pergeseran penjualan ke menu ber-margin rendah (product mix), dan audit harga pembelian bahan.</hasAdviceText>
    <hasChainStep>1:Bandingkan gross margin dengan baseline</hasChainStep>
    <hasChainStep>2:COGS tumbuh lebih cepat dari omzet</hasChainStep>
    <hasChainStep>3:Gross margin turun di bawah ambang batas</hasChainStep>
    <hasChainStep>4:Evaluasi harga jual menu &amp; product mix</hasChainStep>
    <owl:equivalentClass rdf:nodeID="N7f3b17534cb84008841dd7e5d7b52c1c"/>
  </rdf:Description>
