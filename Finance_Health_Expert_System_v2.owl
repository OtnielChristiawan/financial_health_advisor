    <rdfs:label xml:lang="en">has Advisory</rdfs:label>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#FinancialDiagnosis"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#Advisory"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#MultidimensionalDistress">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Multidimensional Distress</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#CriticalCondition"/>
    <rdfs:comment xml:lang="en">Simultaneous presence of margin pressure, OPEX pressure, and cash decline representing a multi-factor operational crisis (Newton &amp; Whitaker distress framework).</rdfs:comment>
    <hasTitle>Distres Multidimensi / Komplikasi Operasional (Multidimensional Distress)</hasTitle>
    <hasDomain>Kesehatan Menyeluruh</hasDomain>
    <hasSeverity>Kritis</hasSeverity>
    <hasRuleId>F11_MultidimensionalDistress</hasRuleId>
    <hasExplanationText>Terjadi komplikasi simultan: margin kotor tertekan, beban operasional melonjak, dan cadangan kas mengalami penurunan.</hasExplanationText>
    <hasAdviceText>Kondisi darurat komplikasi: Segera restrukturisasi biaya secara menyeluruh, negosiasikan ulang harga bahan baku, pangkas pos OPEX non-esensial, dan tahan seluruh pengeluaran kas non-operasional.</hasAdviceText>
    <hasChainStep>1:Margin kotor tertekan di bawah batas historis</hasChainStep>
    <hasChainStep>2:Beban operasional (OPEX) tumbuh melebihi omzet</hasChainStep>
    <hasChainStep>3:Saldo kas mengalami penurunan bersih</hasChainStep>
    <hasChainStep>4:Simpulkan distres operasional multi-dimensi (Newton &amp; Whitaker)</hasChainStep>
    <owl:equivalentClass rdf:nodeID="Nf65f762eba584523b9d71096568a033a"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N3f379bea51324393a1b60edcdcc29a00">
