  <rdf:Description rdf:about="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#NegativeEquityState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Negative Equity State</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#CriticalCondition"/>
    <rdfs:comment xml:lang="en">Monthly financial state where recorded equity is negative (liabilities exceed assets; technically insolvent condition). Catatan: ini indikasi teknis akuntansi, bukan nasihat hukum.</rdfs:comment>
    <hasTitle>Ekuitas Negatif / Indikasi Defisit Modal (Negative Equity State)</hasTitle>
    <hasDomain>Solvabilitas</hasDomain>
    <hasSeverity>Kritis</hasSeverity>
    <hasRuleId>DL_NegativeEquityState</hasRuleId>
    <hasExplanationText>Total kewajiban melebihi total aset usaha (ekuitas negatif / technically insolvent). Catatan: ini indikasi teknis akuntansi, bukan nasihat hukum.</hasExplanationText>
    <hasAdviceText>Ekuitas negatif menandakan defisit modal akumulasi. Pemilik usaha disarankan melakukan injeksi modal atau restrukturisasi kewajiban operasional.</hasAdviceText>
    <hasChainStep>1:Hitung total aset dan total kewajiban</hasChainStep>
    <hasChainStep>2:Total kewajiban melebihi total aset</hasChainStep>
    <hasChainStep>3:Ekuitas tercatat negatif (&lt; 0)</hasChainStep>
    <hasChainStep>4:Rekomendasikan penguatan modal dan restrukturisasi utang</hasChainStep>
    <owl:equivalentClass rdf:nodeID="Nef65494335bd4dab80f2a9c44977e0bc"/>
  </rdf:Description>
