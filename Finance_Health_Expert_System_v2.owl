  <rdf:Description rdf:about="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#MarketingEfficiencyReview">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Marketing Efficiency Review</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#WarningCondition"/>
    <rdfs:subClassOf rdf:nodeID="Na308fb4c9c244d70b970c7829840462e"/>
    <rdfs:comment xml:lang="en">Marketing spend grew faster than revenue; its efficiency should be reviewed (not a conclusion that it is wasteful).</rdfs:comment>
    <hasTitle>Evaluasi Efisiensi Biaya Pemasaran (Marketing Efficiency)</hasTitle>
    <hasDomain>Efisiensi Biaya</hasDomain>
    <hasSeverity>Waspada</hasSeverity>
    <hasRuleId>F04_MarketingEfficiencyReview</hasRuleId>
    <hasExplanationText>Biaya pemasaran/promosi tumbuh lebih cepat daripada pertumbuhan omzet penjualan.</hasExplanationText>
    <hasAdviceText>Evaluasi kanal promosi (iklan medsos, potongan fee MDR/QRIS, diskon menu). Alihkan anggaran ke kanal promosi yang terbukti menghasilkan penjualan langsung.</hasAdviceText>
    <hasChainStep>1:Hitung pengeluaran iklan, promo &amp; MDR</hasChainStep>
    <hasChainStep>2:Biaya marketing tumbuh lebih cepat dari omzet</hasChainStep>
    <hasChainStep>3:Tinjau efektivitas pengembalian promosi</hasChainStep>
    <hasChainStep>4:Optimalkan kanal promosi berkonversi tinggi</hasChainStep>
    <owl:equivalentClass rdf:resource="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#MarketingGrowthExceedsRevenue"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N0ce50b17535040f9b1eaa3fb5705427f">
