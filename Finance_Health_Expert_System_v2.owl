  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#CostEscalation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cost Escalation</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#WarningCondition"/>
    <rdfs:subClassOf rdf:nodeID="Nd04907128a44483bb45aac0e8784cb3d"/>
    <rdfs:subClassOf rdf:nodeID="Nee0aa6e13bc5403d8674047b464837e8"/>
    <rdfs:subClassOf rdf:nodeID="Ne52953b9de054e1fb78a35f0fdb5c549"/>
    <rdfs:subClassOf rdf:nodeID="N252a2ccbb15249b4ab61f5e81374cd8d"/>
    <rdfs:comment xml:lang="en">COGS is growing faster than revenue (early signal). This version does not tell apart higher purchase prices from a shift in what is sold; both are listed as things to check.</rdfs:comment>
    <hasTitle>Eskalasi Biaya Bahan Baku (Cost Escalation)</hasTitle>
    <hasDomain>Efisiensi Biaya</hasDomain>
    <hasSeverity>Waspada</hasSeverity>
    <hasRuleId>F01_CostEscalation</hasRuleId>
    <hasExplanationText>Pertumbuhan biaya bahan baku (COGS) melampaui pertumbuhan omzet penjualan.</hasExplanationText>
    <hasAdviceText>Periksa fluktuasi harga bahan dari supplier, pantau waste/bahan terbuang di bar/kitchen, dan evaluasi porsi resep menu.</hasAdviceText>
    <hasChainStep>1:Hitung pertumbuhan omzet dan COGS</hasChainStep>
    <hasChainStep>2:COGS tumbuh lebih cepat dari pendapatan</hasChainStep>
    <hasChainStep>3:Indikasi eskalasi biaya bahan</hasChainStep>
    <hasChainStep>4:Tinjau harga supplier &amp; porsi resep</hasChainStep>
    <owl:equivalentClass rdf:resource="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#COGSGrowthExceedsRevenue"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N252a2ccbb15249b4ab61f5e81374cd8d">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#recommendsInvestigation"/>
    <owl:hasValue rdf:resource="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#Area_ProductMix"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#hasAdvisory">
