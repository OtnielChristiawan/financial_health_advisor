  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#ProfitCashGap">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Profit Cash Gap</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#WarningCondition"/>
    <rdfs:subClassOf rdf:nodeID="N33dab69262b642f59f02b48e334d0374"/>
    <rdfs:subClassOf rdf:nodeID="N0f425d7e071c41b3bc84b06360953b92"/>
    <rdfs:subClassOf rdf:nodeID="Ne8c4e189a6e14490a329e631bef3f1b5"/>
    <rdfs:subClassOf rdf:nodeID="N85c46eb6cc9a4293aff960972edc7e3e"/>
    <rdfs:comment xml:lang="en">Net profit is positive but the cash balance fell. Cash left through non-expense flows (owner draw, facility purchase, loan principal).</rdfs:comment>
    <hasTitle>Kesenjangan Laba dan Kas (Profit-Cash Gap)</hasTitle>
    <hasDomain>Likuiditas</hasDomain>
    <hasSeverity>Waspada</hasSeverity>
    <hasRuleId>F06_ProfitCashGap</hasRuleId>
    <hasExplanationText>Usaha mencatat laba bersih positif, namun saldo uang kas justru berkurang.</hasExplanationText>
    <hasAdviceText>Laba bukan kas: periksa arus kas keluar untuk prive pemilik, pembelian aset tetap (peralatan), atau pembayaran pokok cicilan pinjaman.</hasAdviceText>
    <hasChainStep>1:Laba bersih tercatat positif</hasChainStep>
    <hasChainStep>2:Perubahan kas periode ini negatif</hasChainStep>
    <hasChainStep>3:Kas keluar lewat pos non-laba-rugi</hasChainStep>
    <hasChainStep>4:Periksa prive, pembelian aset &amp; pokok utang</hasChainStep>
    <owl:equivalentClass rdf:nodeID="N2b557605f4e54f4b84bb2ed78bd480c5"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#GrossMargin">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Gross Margin</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#FinancialIndicator"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#OPEX">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">OPEX</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#FinancialIndicator"/>
    <rdfs:comment xml:lang="en">Operating expenses.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#hasEquity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">has Equity</rdfs:label>
