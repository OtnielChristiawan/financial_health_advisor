    <rdfs:comment>Net margin below own-history lower bound (covers 'same revenue, lower profit').</rdfs:comment>
    <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
