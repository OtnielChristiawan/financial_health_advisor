  <rdf:Description rdf:about="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#LiquidityPressure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Liquidity Pressure</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#WarningCondition"/>
    <rdfs:subClassOf rdf:nodeID="N4748d9daa51b40529800d12d077c009f"/>
    <rdfs:comment xml:lang="en">Cash balance fell during the month.</rdfs:comment>
    <hasTitle>Penurunan Saldo Kas (Liquidity Pressure)</hasTitle>
    <hasDomain>Likuiditas</hasDomain>
    <hasSeverity>Waspada</hasSeverity>
    <hasRuleId>F07_LiquidityPressure</hasRuleId>
    <hasExplanationText>Total saldo kas dan rekening bank mengalami penurunan bersih sepanjang periode ini.</hasExplanationText>
    <hasAdviceText>Pantau arus kas harian secara ketat, tunda pengeluaran non-prioritas, dan pastikan penerimaan omzet disetor ke rekening/kas secara disiplin.</hasAdviceText>
    <hasChainStep>1:Hitung saldo awal kas dan penerimaan</hasChainStep>
    <hasChainStep>2:Arus kas keluar melampaui arus kas masuk</hasChainStep>
    <hasChainStep>3:Penurunan saldo kas bersih</hasChainStep>
    <hasChainStep>4:Kendalikan jadwal pengeluaran kas</hasChainStep>
    <owl:equivalentClass rdf:resource="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#CashDecline"/>
  </rdf:Description>
