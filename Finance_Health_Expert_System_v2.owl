  <rdf:Description rdf:about="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#OwnerDrawLiquidityPressure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Owner Draw Liquidity Pressure</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#WarningCondition"/>
    <rdfs:subClassOf rdf:nodeID="N75e0c0d531ef427fa63575953d076795"/>
    <rdfs:subClassOf rdf:nodeID="Ncc9d4b10c8784eaf89b1655e77fa1bd2"/>
    <rdfs:comment xml:lang="en">Owner draw increased, cash fell, and operating cash flow did not cover the draw.</rdfs:comment>
    <hasTitle>Prive Menekan Likuiditas Usaha (Owner Draw Pressure)</hasTitle>
    <hasDomain>Struktur Modal</hasDomain>
    <hasSeverity>Waspada</hasSeverity>
    <hasRuleId>F08_OwnerDrawLiquidityPressure</hasRuleId>
    <hasExplanationText>Penarikan prive pemilik meningkat dan tidak tertutup oleh arus kas operasi, sehingga menguras cadangan kas.</hasExplanationText>
    <hasAdviceText>Batasi penarikan prive pemilik agar tidak melebihi kemampuan arus kas operasional riil usaha. Jangan menggunakan kas operasional sebagai cadangan pribadi.</hasAdviceText>
    <hasChainStep>1:Prive pemilik meningkat dari bulan lalu</hasChainStep>
    <hasChainStep>2:Arus kas operasi lebih kecil dari total prive</hasChainStep>
    <hasChainStep>3:Kas usaha mengalami penurunan</hasChainStep>
    <hasChainStep>4:Disiplinkan kebijakan penarikan kas pribadi</hasChainStep>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N4012a8a32aac4286afb9b23bfcff0223">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
    <swrl:classPredicate rdf:resource="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#MonthlyFinancialState"/>
    <swrl:argument1 rdf:resource="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#var_s"/>
  </rdf:Description>
