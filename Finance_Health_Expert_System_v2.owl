  <rdf:Description rdf:nodeID="Ne90d340bc1ed407e9f918391cc0871a8">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <swrl:body rdf:nodeID="N9005e918add449a2880142258c69ac02"/>
    <swrl:head rdf:nodeID="N9bdc4654987f4ad59f360c3528e9895f"/>
    <rdfs:label>O01_COGSGrowthExceedsRevenue</rdfs:label>
    <rdfs:comment>Total COGS growth &gt; revenue growth.</rdfs:comment>
    <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
    <sourceStatus>Draft-unvalidated</sourceStatus>
    <sourceNote>md 20.1, 20.6</sourceNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#Receivable">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Receivable</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#CurrentAsset"/>
    <rdfs:comment xml:lang="en">Future extension (not in MVP).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#LiquidityCritical">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Liquidity Critical</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#CriticalCondition"/>
    <rdfs:subClassOf rdf:nodeID="N3a05a95155584edfbfc069573cb47c38"/>
    <rdfs:subClassOf rdf:nodeID="N0d18cb669ce44cd4b8baf717f6dc6d45"/>
    <rdfs:comment xml:lang="en">Cash is falling and cash runway is below the minimum runway the owner/accountant configured (policy parameter, not a universal threshold).</rdfs:comment>
    <hasTitle>Krisis Likuiditas / Cadangan Kas Kritis (Liquidity Critical)</hasTitle>
    <hasDomain>Likuiditas</hasDomain>
    <hasSeverity>Kritis</hasSeverity>
    <hasRuleId>F09_LiquidityCritical</hasRuleId>
    <hasExplanationText>Kas terus menurun dan cadangan kas (cash runway) kurang dari ambang batas aman (di bawah 2 bulan biaya wajib).</hasExplanationText>
    <hasAdviceText>Tindakan darurat: Moratorium penarikan prive, tunda seluruh pembelian aset baru, negosiasikan termin pembayaran, dan prioritaskan kas hanya untuk gaji dan bahan baku pokok.</hasAdviceText>
    <hasChainStep>1:Saldo kas mengalami penurunan</hasChainStep>
    <hasChainStep>2:Sisa cadangan kas &lt; ambang batas aman (2 bulan)</hasChainStep>
    <hasChainStep>3:Risiko gagal bayar operasional wajib</hasChainStep>
    <hasChainStep>4:Ambil tindakan pengamanan kas darurat</hasChainStep>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na04a6c8afb1f4fbcaa0dbf481415378c">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <swrl:body rdf:nodeID="Nd3c3880dc2b64559a1b8ae67739ac965"/>
    <swrl:head rdf:nodeID="N7cede2f993a54bb8ae474120feefd15c"/>
    <rdfs:label>F10_CostDriver</rdfs:label>
    <rdfs:comment>A top-contributing cost category that outgrows revenue is a cost driver (profit bridge).</rdfs:comment>
    <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
    <sourceStatus>Draft-unvalidated</sourceStatus>
    <sourceNote>Draft; ranking computed by backend</sourceNote>
  </rdf:Description>
