  <rdf:Description rdf:about="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#OPEXPressure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">OPEXPressure</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#WarningCondition"/>
    <rdfs:subClassOf rdf:nodeID="Ncbd0c6f0d40c4365803027f9cc219bec"/>
    <rdfs:comment xml:lang="en">Operating expenses grew faster than revenue.</rdfs:comment>
    <hasTitle>Beban Operasional Tumbuh Melebihi Omzet (OPEX Pressure)</hasTitle>
    <hasDomain>Efisiensi Biaya</hasDomain>
    <hasSeverity>Waspada</hasSeverity>
    <hasRuleId>F03_OPEXPressure</hasRuleId>
    <hasExplanationText>Beban operasional (di luar pemasaran) bertumbuh lebih cepat daripada pendapatan usaha.</hasExplanationText>
    <hasAdviceText>Tinjau rincian beban pegawai, utilitas (listrik/air/gas), dan supplies. Pastikan kenaikan biaya sejalan dengan peningkatan kapasitas usaha.</hasAdviceText>
    <hasChainStep>1:Hitung pertumbuhan OPEX non-marketing</hasChainStep>
    <hasChainStep>2:Pertumbuhan beban &gt; pertumbuhan omzet</hasChainStep>
    <hasChainStep>3:Rasio beban operasional berpotensi meningkat</hasChainStep>
    <hasChainStep>4:Audit pos beban operasional terbesar</hasChainStep>
    <owl:equivalentClass rdf:resource="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#OPEXGrowthExceedsRevenue"/>
  </rdf:Description>
