  <rdf:Description rdf:about="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#ProfitPressure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Profit Pressure</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#WarningCondition"/>
    <rdfs:subClassOf rdf:nodeID="N54a80844f9474c079965627322d988bb"/>
    <rdfs:comment xml:lang="en">Net profit margin fell below its own baseline (e.g. same revenue, lower profit).</rdfs:comment>
    <hasTitle>Tekanan Margin Laba Bersih (Profit Pressure)</hasTitle>
    <hasDomain>Profitabilitas</hasDomain>
    <hasSeverity>Waspada</hasSeverity>
    <hasRuleId>F05_ProfitPressure</hasRuleId>
    <hasExplanationText>Margin laba bersih (net profit margin) berada di bawah batas wajar historis usaha.</hasExplanationText>
    <hasAdviceText>Telusuri pemicu penurunan laba bersih dari pos HPP, beban operasional, dan penyusutan; periksa apakah ada pengeluaran insidental yang tidak proporsional.</hasAdviceText>
    <hasChainStep>1:Bandingkan net margin dengan baseline</hasChainStep>
    <hasChainStep>2:Porsi laba bersih terhadap omzet tertekan</hasChainStep>
    <hasChainStep>3:Beban usaha menggerus profitabilitas</hasChainStep>
    <hasChainStep>4:Audit pos pengeluaran &amp; kebocoran biaya</hasChainStep>
    <owl:equivalentClass rdf:resource="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#NetMarginDecline"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#FixedAsset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Fixed Asset</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#Asset"/>
    <rdfs:comment xml:lang="en">Facility/equipment purchased; depreciated monthly instead of expensed at once.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#ReasoningPath">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Reasoning Path</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#ReasoningEvidence"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#isLaterThan">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#Period"/>
