  <rdf:Description rdf:about="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#PersistentMarginPressure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Persistent Margin Pressure</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/otniel/ontologies/2026/9/financial-health-expert-system#MarginPressure"/>
    <rdfs:comment xml:lang="en">Gross margin pressure that persists across consecutive months.</rdfs:comment>
    <hasTitle>Tekanan Margin Berulang (Persistent Margin Pressure)</hasTitle>
    <hasDomain>Profitabilitas</hasDomain>
    <hasSeverity>Waspada</hasSeverity>
    <hasRuleId>DL_PersistentMarginPressure</hasRuleId>
    <hasExplanationText>Gross profit margin tertekan selama minimal dua bulan berturut-turut.</hasExplanationText>
    <hasAdviceText>Tekanan margin kronis: lakukan renegosiasi kontrak supplier jangka panjang, efisiensi resep menu, atau penyesuaian harga jual.</hasAdviceText>
    <hasChainStep>1:Gross margin bulan ini tertekan di bawah baseline</hasChainStep>
    <hasChainStep>2:Gross margin bulan sebelumnya juga tertekan</hasChainStep>
    <hasChainStep>3:Deteksi persistensi tekanan margin antar-periode</hasChainStep>
    <hasChainStep>4:Ambil langkah korektif harga &amp; struktur biaya menu</hasChainStep>
    <owl:equivalentClass rdf:nodeID="N986c9360007242d494aab357a2183219"/>
  </rdf:Description>
